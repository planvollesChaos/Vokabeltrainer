rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jede Familie hat einen langen, zufälligen Familiencode (mind. 20 Zeichen).
    // Nur wer den Code kennt, kann die Profile dieser Familie lesen und schreiben.
    // Es gibt keine Liste aller Familien: alles außerhalb dieses Pfads ist gesperrt.
    match /families/{fam}/profiles/{pid} {
      allow read, delete: if fam.size() >= 20;
      allow create, update: if fam.size() >= 20
        && request.resource.data.keys().hasOnly(['name', 'role', 'avatar', 'p', 'u'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
    }
  }
}
